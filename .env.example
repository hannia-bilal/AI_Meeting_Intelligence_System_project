# LLM Provider selection: "gemini", "openai", or "mock" (default for offline dev/tests)
AI_PROVIDER=mock

# Google Gemini API Configuration (if using AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Configuration (if using AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
