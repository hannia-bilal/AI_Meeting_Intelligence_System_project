# ==============================================================================
# AI Meeting Intelligence System - Environment Configuration
# Module: AI Meeting Intelligence (Muhammad Awais)
# ==============================================================================

# LLM Provider selection: "groq", "gemini", "openai", or "mock" (default)
AI_PROVIDER=groq

# ------------------------------------------------------------------------------
# FREE LLM Option 1: Groq API (Recommended for ultra-fast, free local testing)
# Get a free key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# FREE LLM Option 2: Google Gemini API (Free tier from Google AI Studio)
# Get a free key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Option 3: OpenAI API (Paid / Commercial)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini


# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# ==============================================================================
# AI Meeting Intelligence System - Environment Configuration
# Module: Speech Processing (Taskeen Mustafa)
# ==============================================================================

# Diarization Model Configuration
HF_TOKEN=your_huggingface_token_here

